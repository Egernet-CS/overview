# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Local LLM (LM Studio / OpenAI-compatible)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=

# LLM selection: auto | claude | local (default: auto)
OVERVIEW_LLM_MODE=auto

# Indexing tuning
OVERVIEW_CONCURRENCY=3
OVERVIEW_MAX_FILE_SIZE=50000
OVERVIEW_MAX_CHARS_PER_FILE=12000
OVERVIEW_RETRY_ATTEMPTS=2

# Output
OVERVIEW_OUT_DIR=.overview
